{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls ": "allow",
      "ls -": "allow",
      "cat ": "allow",
      "echo ": "allow",
      "tail ": "allow",
      "head ": "allow",
      "wc ": "allow",
      "sort ": "allow",
      "uniq ": "allow",
      "pwd": "allow",
      "date": "allow",
      "which ": "allow",
      "printf ": "allow",
      "dirname ": "allow",
      "basename ": "allow",
      "git diff ": "allow",
      "git log ": "allow",
      "git show ": "allow",
      "git status": "allow",
      "git branch ": "allow"
    },
    "describe_image": "allow"
  },
  "plugin": [
    [
      ".opencode/lib/image-vision.ts",
      {
        "vision_model": "opencode-go/mimo-v2.5-pro"
      }
    ]
  ]
}
