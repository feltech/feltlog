{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "xargs grep *": "allow",
      "cat *": "allow",
      "cat > *": "ask",
      "cat > /tmp/*": "allow",
      "cat << *": "ask",
      "echo *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "xxd *": "allow",
      "od *": "allow",
      "diff *": "allow",
      "wc *": "allow",
      "test *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "date *": "allow",
      "true": "allow",
      "false": "allow",
      "which *": "allow",
      "printf *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "ps aux": "allow",
      "pgrep *": "allow",
      "sed '*": "allow",
      "sed -n '*": "allow",
      "cut *": "allow",
      "rg *": "allow",
      "strings *": "allow",
      "file *": "allow",
      "jq *": "allow",
      "pup *": "allow",
      "tee *": "allow",
      "mkdir *": "allow",
      "sleep *": "allow",
      "maestro *": "allow",
      "ss *": "allow",
      "netstat *": "allow",
      "lsof *": "allow",
      "adb *": "allow",
      "curl *": "allow",
      "awk '*": "allow",
      "tabs *": "allow",
      "read *": "allow",
      "base64 *": "allow",
      "jar *": "allow",
      "javap *": "allow",
      "git add *": "allow",
      "git reset HEAD": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git branch *": "allow",
      "git stash *": "allow",
      "git reflog *": "allow",
      "git fetch *": "allow",
      "git ls-files *": "allow",
      "node -c *": "allow",
      "node --version *": "allow",
      "node-gyp *": "allow",
      "npm --version *": "allow",
      "npm start *": "allow",
      "npm run *": "allow",
      "npm ls *": "allow",
      "npm test *": "allow",
      "npm view *": "allow",
      "npm help *": "allow",
      "npm rebuild *": "allow",
      "npx jest *": "allow",
      "timeout * npx jest *": "allow",
      "npx expo *": "allow",
      "npx tsc *": "allow",
      "npx markdownlint *": "allow",
      "bash -c \"npm run format && npm run lint\"": "allow",
      "bash -c \"npm run format && npm run lint && npm run lint:md\"": "allow",
      "bash -c \"npm run android > android.log 2>&1 &\"": "allow",
      "python3 -m json.tool *": "allow",
      "python -m json.tool *": "allow",
      "python3 -m xml.dom.minidom *": "allow",
      "python -m xml.dom.minidom *": "allow",
      "./gradlew *": "allow"
    },
    "describe_image": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    }
  },
  "mcp": {
    "maestro": {
      "type": "local",
      "command": ["maestro", "mcp"],
      "enabled": true
    }
  },
  "plugin": [
    [
      ".opencode/lib/image-vision.ts",
      {
        "vision_model": "ollama-cloud/kimi-k2.6"
      }
    ]
  ]
}
