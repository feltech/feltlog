{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "cat > *": "ask",
      "echo *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "xxd *": "allow",
      "wc *": "allow",
      "test *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "date *": "allow",
      "true": "allow",
      "false": "allow",
      "which *": "allow",
      "printf *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "ps aux": "allow",
      "pgrep *": "allow",
      "sed '*": "allow",
      "sed -n '*": "allow",
      "cut *": "allow",
      "rg *": "allow",
      "strings *": "allow",
      "file *": "allow",
      "jq *": "allow",
      "tee *": "allow",
      "mkdir *": "allow",
      "sleep *": "allow",
      "maestro *": "allow",
      "ss *": "allow",
      "netstat *": "allow",
      "lsof *": "allow",
      "adb *": "allow",
      "curl *": "allow",
      "awk '*": "allow",
      "tabs *": "allow",
      "git add *": "allow",
      "git reset HEAD": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git branch *": "allow",
      "git stash *": "allow",
      "node -c *": "allow",
      "node --version": "allow",
      "npm run *": "allow",
      "npm ls *": "allow",
      "npm test *": "allow",
      "npx jest *": "allow",
      "npx tsc *": "allow",
      "npx markdownlint *": "allow",
      "bash -c \"npm run format && npm run lint\"": "allow",
      "bash -c \"npm run format && npm run lint && npm run lint:md\"": "allow",
      "bash -c \"npm run android > android.log 2>&1 &\"": "allow",
      "bash -c \"grep -q 'BUILD SUCCESSFUL' android.log": "allow",
      "bash -c \"grep -q 'Bundled' android.log": "allow",
      "bash -c \"grep -q 'Opening exp+feltlog' android.log": "allow",
      "python3 -m json.tool *": "allow",
      "python -m json.tool *": "allow",
      "python3 -m xml.dom.minidom *": "allow",
      "python -m xml.dom.minidom *": "allow",
      "pkill -f 'react-native' 2>/dev/null": "allow",
      "pkill -f 'maestro.cli.AppKt mcp' 2>/dev/null": "allow",
      "pkill -f metro 2>/dev/null": "allow",
      "pkill -f \"metro\" 2>/dev/null": "allow",
      "pkill -9 -f \"metro\" 2>/dev/null": "allow",
      "pkill -f 'node.*metro' 2>/dev/null": "allow"
    },
    "describe_image": "allow"
  },
  "agent": {
    "explore": {
      "disable": true
    }
  },
  "mcp": {
    "maestro": {
      "type": "local",
      "command": ["maestro", "mcp"],
      "enabled": true
    }
  },
  "plugin": [
    [
      ".opencode/lib/image-vision.ts",
      {
        "vision_model": "ollama-cloud/kimi-k2.6"
      }
    ]
  ]
}
