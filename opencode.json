{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "xxd *": "allow",
      "wc *": "allow",
      "test *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "date": "allow",
      "which *": "allow",
      "printf *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "sed '*": "allow",
      "sed -n '*": "allow",
      "rg *": "allow",
      "git add *": "allow",
      "git reset HEAD": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git branch *": "allow",
      "npm run *": "allow",
      "nix develop ./build_env --command npm run *": "allow",
      "nix develop ./build_env --command npm test": "allow",
      "nix develop ./build_env --command npx jest": "allow"
    },
    "describe_image": "allow"
  },
  "agent": {
    "explore": {
      "disable": true
    }
  },
  "plugin": [
    [
      ".opencode/lib/image-vision.ts",
      {
        "vision_model": "opencode-go/mimo-v2.5-pro"
      }
    ]
  ]
}
