{
  "name": "feltlog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:release": "cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test-watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint '**/*.md'",
    "e2e:sync-time": "adb wait-for-device && adb shell su root date -u @$(date +%s)",
    "e2e": "npm run e2e:sync-time && maestro test --test-output-dir ./test_output e2e",
    "e2e:flow": "npm run e2e:sync-time && maestro test --test-output-dir ./test_output",
    "e2e:kill-maestro-mcp": "pkill -f 'maestro.cli.AppKt mcp'",
    "e2e:kill-metro": "pkill -f 'node.*metro'; pkill -f 'expo start'",
    "e2e:adb-check": "adb shell echo ok",
    "e2e:adb-restart": "adb kill-server && adb start-server",
    "e2e:adb-uptime": "adb shell uptime",
    "e2e:adb-pidof": "adb shell pidof com.feltech.feltlog",
    "e2e:start-device": "maestro start-device --platform android --device-model pixel_6 --device-os android-36",
    "e2e:wait-build-success": "grep -q 'BUILD SUCCESSFUL' android.log || timeout 300 tail -F android.log | grep -m1 'BUILD SUCCESSFUL'",
    "e2e:wait-bundled": "grep -q 'Bundled' android.log || timeout 120 tail -F android.log | grep -m1 'Bundled'",
    "e2e:wait-opening": "grep -q 'Opening exp+feltlog' android.log || timeout 60 tail -F android.log | grep -m1 'Opening exp+feltlog'",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "caller": {
            "platform": "android"
          }
        }
      ]
    },
    "setupFilesAfterEnv": [
      "expo-sqlite-mock/src/setup.ts"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "node_modules/(?!kysely-expo|use-immer|immer|((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|uuid)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!src/**/*.web.{ts,tsx}",
      "!app/**/*.web.{ts,tsx}",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/domain/entities/JournalEntry.ts",
      "src/domain/repositories/JournalRepository.ts",
      "src/data/database/schema.ts",
      "src/presentation/components/useColorScheme.ts",
      "src/presentation/components/useColorScheme.web.ts",
      "src/presentation/components/useClientOnlyValue.web.ts",
      "app/\\+html.tsx",
      "src/test-utils/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "better-sqlite3": "^12.9.0",
    "expo": "^56.0.0",
    "expo-constants": "~56.0.16",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "immer": "^11.1.8",
    "kysely": "^0.28.7",
    "kysely-expo": "^5.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "use-immer": "^0.11.0",
    "uuid": "^14.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.md": "markdownlint --fix"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@react-native/eslint-config": "^0.75.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "expo-sqlite-mock": "^4.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "kysely-ctl": "^0.21.0",
    "lint-staged": "^17.0.5",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "prettier-plugin-jsdoc": "^1.8.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "~6.0.3",
    "typescript-language-server": "^5.1.3"
  },
  "overrides": {
    "expo-sqlite": "~56.0.4"
  },
  "private": true
}
