{
  "name": "feltlog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test-watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint '**/*.md'",
    "e2e": "maestro test e2e",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "caller": {
            "platform": "android"
          }
        }
      ]
    },
    "setupFilesAfterEnv": [
      "expo-sqlite-mock/src/setup.ts"
    ],
    "testTimeout": 10000,
    "transformIgnorePatterns": [
      "node_modules/(?!kysely-expo|use-immer|immer|((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|uuid)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!src/**/*.web.{ts,tsx}",
      "!app/**/*.web.{ts,tsx}",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/domain/entities/JournalEntry.ts",
      "src/domain/repositories/JournalRepository.ts",
      "src/data/database/schema.ts",
      "src/presentation/components/useColorScheme.ts",
      "src/presentation/components/useColorScheme.web.ts",
      "src/presentation/components/useClientOnlyValue.web.ts",
      "app/\\+html.tsx"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.0.14",
    "better-sqlite3": "^12.9.0",
    "expo": "~53.0.27",
    "expo-font": "~13.3.2",
    "expo-linking": "7.1.7",
    "expo-location": "~18.1.6",
    "expo-router": "5.1.0",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "immer": "^11.1.8",
    "kysely": "^0.28.7",
    "kysely-expo": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.6",
    "react-native-get-random-values": "^1.11.0",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "~0.20.0",
    "use-immer": "^0.11.0",
    "uuid": "^10.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.md": "markdownlint --fix"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@react-native/eslint-config": "^0.75.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "expo-sqlite-mock": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "kysely-ctl": "^0.21.0",
    "lint-staged": "^17.0.5",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "prettier-plugin-jsdoc": "^1.8.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3",
    "typescript-language-server": "^5.1.3"
  },
  "private": true
}
